VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- Video del hero (fondo, siempre en silencio) ---
VITE_HERO_VIDEO_ENABLED=true
VITE_HERO_VIDEO_DESKTOP=/videos/hero-horizontal.mp4
VITE_HERO_VIDEO_MOBILE=/videos/hero-vertical.mp4
VITE_HERO_VIDEO_SLIDE_INDEX=0

# --- Popup de bienvenida con el mensaje ---
VITE_INTRO_POPUP_ENABLED=false
VITE_INTRO_POPUP_DESKTOP=/videos/hero-horizontal.mp4
VITE_INTRO_POPUP_MOBILE=/videos/hero-vertical.mp4
VITE_INTRO_POPUP_ONCE=true
VITE_INTRO_POPUP_STORAGE_KEY=df-intro-video-v1
VITE_INTRO_POPUP_DELAY_MS=800
